[package]
name = "{name}"
version = "0.0.0"
edition = "2021"
description = "A PostgreSQL extension built with pgrx"
# For PGXN: use license values like "postgresql", "mit", "bsd", "apache-2.0", etc.
license = "postgresql"
authors = ["Your Name <your.email@example.com>"]
repository = "https://github.com/yourusername/{name}"
homepage = "https://github.com/yourusername/{name}"
documentation = "https://docs.rs/{name}/"
keywords = ["postgres", "postgresql", "extension", "pgrx"]
categories = ["database"]
publish = false

# PGXN Metadata
# See https://pgxn.org/meta/spec.txt for complete specification
[package.metadata.pgxn]
# Short one-line description (for PGXN abstract field)
abstract = "Brief description of your extension"

# Tags for PGXN categorization and discoverability
tags = ["postgresql", "extension"]

# Maintainer information (can be multiple)
maintainer = ["Your Name <your.email@example.com>"]

# Bug tracking URL
bugtracker = "https://github.com/yourusername/{name}/issues"

# Runtime requirements - PostgreSQL version and dependencies
# Uncomment and modify as needed for your extension
# [package.metadata.pgxn.prereqs.runtime.requires]
# PostgreSQL = "13.0.0"
# # Other extension dependencies
# # "some_extension" = "1.0.0"

# Recommended extensions for enhanced functionality
# [package.metadata.pgxn.prereqs.runtime.recommends]
# # "optional_extension" = "1.0.0"

[lib]
crate-type = ["cdylib", "lib"]

[[bin]]
name = "pgrx_embed_{name}"
path = "./src/bin/pgrx_embed.rs"

[features]
default = ["pg13"]
pg13 = ["pgrx/pg13", "pgrx-tests/pg13" ]
pg14 = ["pgrx/pg14", "pgrx-tests/pg14" ]
pg15 = ["pgrx/pg15", "pgrx-tests/pg15" ]
pg16 = ["pgrx/pg16", "pgrx-tests/pg16" ]
pg17 = ["pgrx/pg17", "pgrx-tests/pg17" ]
pg18 = ["pgrx/pg18", "pgrx-tests/pg18" ]
pg_test = []

[dependencies]
pgrx = "=0.17.0"

[dev-dependencies]
pgrx-tests = "=0.17.0"

[profile.dev]
panic = "unwind"

[profile.release]
panic = "unwind"
opt-level = 3
lto = "fat"
codegen-units = 1
